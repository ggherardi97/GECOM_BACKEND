# App
NODE_ENV=development
PORT=3000

# Database (TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=gecom

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gecom?schema=public

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Tracking (premium feature)
TRACKING_PREMIUM_DEFAULT_ENABLED=true
TRACKING_PREMIUM_TENANTS=
TRACKING_CACHE_TTL_MS=60000
TRACKING_CACHE_MAX_ENTRIES=500
TRACKING_PROVIDER_MIN_INTERVAL_MS=1000

# Flightradar24 provider
FR24_BASE_URL=
FR24_SNAPSHOT_ENDPOINT=
FR24_ROUTE_ENDPOINT=

# MarineTraffic provider
MT_BASE_URL=
MT_VESSEL_ENDPOINT=
MT_ROUTE_ENDPOINT=

