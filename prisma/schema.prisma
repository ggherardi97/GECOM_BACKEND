model leads {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id            String           @db.Uuid
  name                 String           @db.VarChar(255)
  type                 lead_type_enum
  company_name         String?          @db.VarChar(255)
  first_name           String?          @db.VarChar(150)
  last_name            String?          @db.VarChar(150)
  email                String?          @db.VarChar(255)
  phone                String?          @db.VarChar(50)
  website              String?          @db.VarChar(255)
  source               lead_source_enum @default(MANUAL)
  owner_user_id        String           @db.Uuid
  status               lead_status_enum @default(NEW)
  stage_id             String?          @db.Uuid
  disqualify_reason    String?
  converted_company_id String?          @db.Uuid
  converted_contact_id String?          @db.Uuid
  converted_at         DateTime?        @db.Timestamp(6)
  estimated_value      Decimal?         @db.Decimal(19, 4)
  currency_code        String?          @db.VarChar(3)
  notes                String?
  created_at           DateTime         @default(now()) @db.Timestamp(6)
  updated_at           DateTime         @default(now()) @db.Timestamp(6)

  owner_user         users                 @relation("LeadOwner", fields: [owner_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_leads_owner_user")
  stage              lead_pipeline_stages? @relation(fields: [stage_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_leads_stage")
  converted_company  companies?            @relation("LeadConvertedCompany", fields: [converted_company_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_leads_converted_company")

  stage_history lead_stage_history[]
  activities    lead_activities[]
  tags          lead_tag_links[]

  @@index([tenant_id, status], map: "IDX_leads_tenant_status")
  @@index([tenant_id, owner_user_id], map: "IDX_leads_tenant_owner")
  @@index([tenant_id, stage_id], map: "IDX_leads_tenant_stage")
}

model lead_stage_history {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
