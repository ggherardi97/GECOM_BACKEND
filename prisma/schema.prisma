generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model migrations {
  id        Int    @id(map: "PK_8c82d7f526340ab734260ea46be") @default(autoincrement())
  timestamp BigInt
  name      String @db.VarChar
}

model tenants {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String    @db.VarChar(255)
  slug       String    @db.VarChar(80)
  company_id String?   @unique @db.Uuid
  status     Int       @default(1) @db.SmallInt
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  company companies? @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([slug], map: "uq_tenants_slug")
  @@index([status], map: "IDX_tenants_status")
  @@index([deleted_at], map: "IDX_tenants_deleted_at")
}

model users {
  id              String           @id(map: "PK_a3ffb1c0c8416b9fc6f907b7433") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id       String           @db.Uuid
  full_name       String           @db.VarChar(255)
  email           String           @unique(map: "UQ_97672ac88f789774dd47f7c8be3") @db.VarChar(255)
  password        String           @db.VarChar(255)
  role            user_role_enum   @default(USER)
  status          user_status_enum @default(ACTIVE)
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @default(now()) @db.Timestamp(6)
  company_id      String?          @db.Uuid
  phonenumber     String?          @db.VarChar(50)
  first_access    Boolean          @default(true)
  profile_picture Bytes?           @db.ByteA
  acept_terms     Boolean          @default(false)

  primaryForCompanies companies[]          @relation("CompanyPrimaryUser")
  documentsCreated    documents[]          @relation("UserDocumentsCreated")
  savedViewsOwned     saved_views[]        @relation("UserSavedViewsOwned")
  defaultViews        user_default_views[] @relation("UserDefaultViews")

  created_notifications notifications[]      @relation("NotificationCreatedBy")
  notification_reads    notification_reads[]

  owned_boards               boards[]                @relation("BoardOwner")
  created_board_cards        board_cards[]           @relation("BoardCardCreatedBy")
  assigned_board_cards       board_cards[]           @relation("BoardCardAssignedTo")
  board_card_comments        board_card_comments[]
  board_card_audit_entries   board_card_audit[]      @relation("BoardCardAuditCreatedBy")
  board_card_assignments     board_card_assignees[]
  owned_leads                leads[]                 @relation("LeadOwner")
  lead_stage_history_changes lead_stage_history[]    @relation("LeadStageChangedBy")
  lead_activities_created    lead_activities[]       @relation("LeadActivityCreatedBy")
  lead_activities_assigned   lead_activities[]       @relation("LeadActivityAssignedTo")
  owned_incidents            incidents[]             @relation("IncidentOwner")
  opened_incidents           incidents[]             @relation("IncidentOpenedBy")
  queue_memberships          service_queue_members[]
  service_resources_links    service_resources[]     @relation("ServiceResourceUser")
  assigned_service_tasks     service_tasks[]         @relation("ServiceTaskAssignedTo")
  created_service_tasks      service_tasks[]         @relation("ServiceTaskCreatedBy")
  trade_simulations_created  trade_simulations[]     @relation("TradeSimulationCreatedByUser")

  password_resets password_resets?
  processes       processes[]
  sessions        sessions?
  company         companies?       @relation("CompanyUsers", fields: [company_id], references: [id], map: "FK_users_company_id")

  @@index([company_id], map: "IDX_users_company_id")
  @@index([tenant_id], map: "IDX_users_tenant_id")
}

model sessions {
  id            String    @id(map: "PK_3238ef96f18b355b671619111bc") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id     String?   @db.Uuid
  user_id       String    @unique(map: "UQ_085d540d9f418cfbdc7bd55bb19") @db.Uuid
  refresh_token String
  device_info   String?   @db.VarChar
  ip_address    String?   @db.VarChar
  expires_at    DateTime? @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_085d540d9f418cfbdc7bd55bb19")

  @@index([tenant_id], map: "IDX_sessions_tenant_id")
}

model customers {
  id         String    @id(map: "PK_133ec679a801fab5e070f73d3ea") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name  String    @db.VarChar(255)
  email      String    @unique(map: "UQ_8536b8b85c06969f84f0c098b03") @db.VarChar(255)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @default(now()) @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  password   String?   @db.VarChar(255)
}

model password_resets {
  id         String   @id(map: "PK_4816377aa98211c1de34469e742") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @unique(map: "UQ_password_resets_user_id") @db.Uuid
  token      String   @db.VarChar(255)
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_f7a4c3bc48f24df007936d217be")

  @@index([tenant_id], map: "IDX_password_resets_tenant_id")
}

model companies {
  id                 String    @id(map: "PK_d4bc3e82a314fa9e29f652c2c22") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id          String?   @db.Uuid
  company_name       String    @db.VarChar
  user_id            String?   @db.Uuid
  phone              String?   @db.VarChar
  company_number     String?   @db.VarChar
  sector             String?   @db.VarChar
  category           String?   @db.VarChar
  address_line       String?   @db.VarChar
  address_street     String?   @db.VarChar
  address_number     String?   @db.VarChar
  address_city       String?   @db.VarChar
  address_country    String?   @db.VarChar
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)
  deleted_at         DateTime? @db.Timestamp(6)
  address_postalcode String?   @db.VarChar
  address_state      String?   @db.VarChar
  number_of_invoices Int       @default(0)
  language           String?   @db.VarChar
  company_picture    Bytes?    @db.ByteA

  primaryUser       users?              @relation("CompanyPrimaryUser", fields: [user_id], references: [id], map: "FK_ee0839cba07cb0c52602021ad4b")
  documents         documents[]         @relation("CompanyDocuments")
  invoices          invoices[]          @relation("CompanyInvoices")
  processes         processes[]         @relation("CompanyProcesses")
  users             users[]             @relation("CompanyUsers")
  notifications     notifications[]     @relation("CompanyNotifications")
  boards            boards[]            @relation("BoardCompany")
  board_cards       board_cards[]       @relation("BoardCardCompany")
  converted_leads   leads[]             @relation("LeadConvertedCompany")
  incidents         incidents[]
  customer_assets   customer_assets[]
  trade_simulations trade_simulations[]

  // opposite side of tenants.company
  tenant tenants?

  @@index([tenant_id], map: "IDX_companies_tenant_id")
}

model events {
  id               String    @id(map: "PK_40731c7151fe4be3116e45ddf73") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id        String?   @db.Uuid
  related_table    String    @db.VarChar(50)
  related_id       String    @db.Uuid
  status           Int?
  title            String    @db.VarChar(150)
  description      String?
  type             Int
  start_time       DateTime  @db.Timestamp(6)
  end_time         DateTime? @db.Timestamp(6)
  finished         Boolean   @default(false)
  document_related Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamp(6)

  @@index([related_table, related_id], map: "IDX_EVENTS_RELATED")
  @@index([type], map: "IDX_EVENTS_TYPE")
  @@index([tenant_id], map: "IDX_events_tenant_id")
}

model processes {
  id                 String    @id(map: "PK_566885de50f7d20a6df306c12e6") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id          String?   @db.Uuid
  process_number     String    @db.VarChar(100)
  status             Int
  status_config_id   String?   @db.Uuid
  invoice            String?   @db.VarChar(100)
  company_id         String    @db.Uuid
  primary_contact_id String    @db.Uuid
  ship_date          DateTime? @db.Timestamp(6)
  completed          Int       @default(0)
  total_value        Decimal   @default(0) @db.Decimal(19, 4)
  created_on         DateTime  @default(now()) @db.Timestamp(6)
  deleted_at         DateTime? @db.Timestamp(6)
  process_type_id    String?   @db.Uuid

  users         users          @relation(fields: [primary_contact_id], references: [id], onUpdate: NoAction, map: "FK_6a27da7b5df1b56ebe811b02f4f")
  companies     companies      @relation("CompanyProcesses", fields: [company_id], references: [id], onUpdate: NoAction, map: "FK_756ba2f334b54581a432b83929b")
  process_types process_types? @relation(fields: [process_type_id], references: [id], onUpdate: NoAction, map: "FK_ded16035eaef6f141a36aea73b3")
  status_config status_configs? @relation("ProcessStatusConfig", fields: [status_config_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_processes_status_config")
  transports    transports[]
  boards        boards[]       @relation("BoardProcess")
  board_cards   board_cards[]  @relation("BoardCardProcess")

  @@unique([process_number])
  @@index([company_id], map: "IDX_PROCESS_COMPANY_ID")
  @@index([process_number], map: "IDX_PROCESS_PROCESS_NUMBER")
  @@index([tenant_id, status_config_id], map: "IDX_processes_tenant_status_config")
  @@index([tenant_id], map: "IDX_processes_tenant_id")
}

model currencies {
  id         String     @id(map: "PK_d528c54860c4182db13548e08c4") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code       String     @unique(map: "UQ_9f8d0972aeeb5a2277e40332d29") @db.VarChar(3)
  name       String     @db.VarChar(100)
  symbol     String?    @db.VarChar(10)
  decimals   Int        @default(2) @db.SmallInt
  is_active  Boolean    @default(true)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  invoices   invoices[]
  products   products[]
}

model products {
  id                     String                   @id(map: "PK_0806c755e0aca124e67c0cf6d7d") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id              String?                  @db.Uuid
  product_code           String                   @unique(map: "uq_products_product_code") @db.VarChar(80)
  name                   String                   @db.VarChar(255)
  brand                  String?                  @db.VarChar(120)
  unit                   String?                  @db.VarChar(50)
  description            String?
  currency_id            String                   @db.Uuid
  default_unit_price     Decimal                  @default(0) @db.Decimal(19, 4)
  default_tax_rate       Decimal                  @default(0) @db.Decimal(9, 4)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  invoice_lines          invoice_lines[]
  trade_simulation_items trade_simulation_items[]
  currencies             currencies               @relation(fields: [currency_id], references: [id], onUpdate: NoAction, map: "fk_products_currency")

  @@index([currency_id], map: "idx_products_currency_id")
  @@index([is_active], map: "idx_products_is_active")
  @@index([tenant_id], map: "IDX_products_tenant_id")
}

model invoices {
  id                          String          @id(map: "PK_668cef7c22a427fd822cc1be3ce") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                   String?         @db.Uuid
  invoice_seq                 BigInt          @default(autoincrement())
  invoice_number              String          @unique(map: "UQ_d8f8d3788694e1b3f96c42c36fb") @db.VarChar(30)
  company_id                  String          @db.Uuid
  currency_id                 String          @db.Uuid
  quote_at                    DateTime?       @db.Timestamptz(6)
  exchange_rate               Decimal         @default(1) @db.Decimal(19, 8)
  version                     Int             @default(1)
  billing_address_line1       String?
  billing_address_line2       String?
  billing_address_city        String?
  billing_address_state       String?
  billing_address_postal_code String?
  billing_address_country     String?
  status                      Int             @default(0) @db.SmallInt
  status_config_id            String?         @db.Uuid
  subtotal                    Decimal         @default(0) @db.Decimal(19, 4)
  discount_percent            Int             @default(0)
  discount_amount             Decimal         @default(0) @db.Decimal(19, 4)
  tax_total                   Decimal         @default(0) @db.Decimal(19, 4)
  fee_total                   Decimal         @default(0) @db.Decimal(19, 4)
  total                       Decimal         @default(0) @db.Decimal(19, 4)
  issued_at                   DateTime?       @db.Timestamptz(6)
  due_at                      DateTime?       @db.Timestamptz(6)
  paid_at                     DateTime?       @db.Timestamptz(6)
  notes                       String?
  terms                       String?
  created_at                  DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime        @default(now()) @db.Timestamptz(6)
  invoice_lines               invoice_lines[]
  companies                   companies       @relation("CompanyInvoices", fields: [company_id], references: [id], onUpdate: NoAction, map: "fk_invoices_company")
  currencies                  currencies      @relation(fields: [currency_id], references: [id], onUpdate: NoAction, map: "fk_invoices_currency")
  status_config               status_configs? @relation("InvoiceStatusConfig", fields: [status_config_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_invoices_status_config")
  boards                      boards[]        @relation("BoardInvoice")
  board_cards                 board_cards[]   @relation("BoardCardInvoice")

  @@index([company_id], map: "idx_invoices_company_id")
  @@index([company_id, status], map: "idx_invoices_company_status")
  @@index([currency_id], map: "idx_invoices_currency_id")
  @@index([status], map: "idx_invoices_status")
  @@index([tenant_id, status_config_id], map: "IDX_invoices_tenant_status_config")
  @@index([tenant_id], map: "IDX_invoices_tenant_id")
}

model invoice_lines {
  id               String  @id(map: "PK_3d18eb48142b916f581f0c21a65") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id        String? @db.Uuid
  invoice_id       String  @db.Uuid
  line_number      Int
  product_id       String? @db.Uuid
  description      String?
  unit             String? @db.VarChar(50)
  unit_price       Decimal @default(0) @db.Decimal(19, 4)
  quantity         Decimal @default(1) @db.Decimal(19, 4)
  tax_rate         Decimal @default(0) @db.Decimal(9, 4)
  tax_amount       Decimal @default(0) @db.Decimal(19, 4)
  discount_percent Int     @default(0)
  discount_amount  Decimal @default(0) @db.Decimal(19, 4)
  line_subtotal    Decimal @default(0) @db.Decimal(19, 4)
  line_total       Decimal @default(0) @db.Decimal(19, 4)

  invoices invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_lines_invoice")
  products products? @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_invoice_lines_product")

  @@unique([invoice_id, line_number], map: "uq_invoice_lines_invoice_line_number")
  @@index([invoice_id], map: "idx_invoice_lines_invoice_id")
  @@index([product_id], map: "idx_invoice_lines_product_id")
  @@index([tenant_id], map: "IDX_invoice_lines_tenant_id")
}

model trade_simulations {
  id                       String                         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                String                         @db.Uuid
  company_id               String                         @db.Uuid
  type                     TradeSimulationType
  status                   TradeSimulationStatus          @default(DRAFT)
  calculation_mode         TradeSimulationCalculationMode @default(MANUAL)
  currency                 String                         @db.VarChar(3)
  exchange_rate            Decimal?                       @db.Decimal(19, 8)
  incoterm                 String?                        @db.VarChar(20)
  origin_country           String?                        @db.VarChar(2)
  destination_state        String?                        @db.VarChar(2)
  customs_value            Decimal                        @db.Decimal(19, 4)
  freight_international    Decimal?                       @db.Decimal(19, 4)
  insurance_international  Decimal?                       @db.Decimal(19, 4)
  other_additions          Decimal?                       @db.Decimal(19, 4)
  icms_rate                Decimal?                       @db.Decimal(9, 6)
  calculation_payload_json Json?
  created_by_user_id       String                         @db.Uuid
  created_at               DateTime                       @default(now()) @db.Timestamp(6)
  updated_at               DateTime                       @default(now()) @db.Timestamp(6)

  company         companies                @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_trade_simulations_company")
  created_by_user users                    @relation("TradeSimulationCreatedByUser", fields: [created_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_trade_simulations_created_by_user")
  items           trade_simulation_items[]
  costs           trade_simulation_costs[]
  taxes           trade_simulation_taxes[]

  @@index([tenant_id], map: "IDX_trade_simulations_tenant_id")
  @@index([tenant_id, company_id], map: "IDX_trade_simulations_tenant_company")
  @@index([tenant_id, status], map: "IDX_trade_simulations_tenant_status")
}

model trade_simulation_items {
  id                      String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id               String   @db.Uuid
  trade_simulation_id     String   @db.Uuid
  product_id              String?  @db.Uuid
  description             String   @db.VarChar(255)
  ncm                     String   @db.VarChar(20)
  quantity                Decimal  @db.Decimal(19, 6)
  unit_price              Decimal  @db.Decimal(19, 6)
  item_value              Decimal  @db.Decimal(19, 4)
  freight_allocated       Decimal? @db.Decimal(19, 4)
  insurance_allocated     Decimal? @db.Decimal(19, 4)
  customs_value_allocated Decimal? @db.Decimal(19, 4)
  notes                   String?  @db.VarChar(500)
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @default(now()) @db.Timestamp(6)

  trade_simulation trade_simulations        @relation(fields: [trade_simulation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_trade_simulation_items_simulation")
  product          products?                @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_trade_simulation_items_product")
  taxes            trade_simulation_taxes[]

  @@index([tenant_id], map: "IDX_trade_simulation_items_tenant_id")
  @@index([tenant_id, trade_simulation_id], map: "IDX_trade_simulation_items_tenant_simulation")
  @@index([tenant_id, ncm], map: "IDX_trade_simulation_items_tenant_ncm")
}

model trade_simulation_costs {
  id                  String                              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id           String                              @db.Uuid
  trade_simulation_id String                              @db.Uuid
  cost_type           TradeSimulationCostType
  amount              Decimal                             @db.Decimal(19, 4)
  currency            String                              @db.VarChar(3)
  exchange_rate       Decimal?                            @db.Decimal(19, 8)
  is_in_icms_base     Boolean                             @default(true)
  allocation_method   TradeSimulationCostAllocationMethod @default(TOTAL)
  notes               String?                             @db.VarChar(500)
  created_at          DateTime                            @default(now()) @db.Timestamp(6)
  updated_at          DateTime                            @default(now()) @db.Timestamp(6)

  trade_simulation trade_simulations @relation(fields: [trade_simulation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_trade_simulation_costs_simulation")

  @@index([tenant_id], map: "IDX_trade_simulation_costs_tenant_id")
  @@index([tenant_id, trade_simulation_id], map: "IDX_trade_simulation_costs_tenant_simulation")
}

model trade_simulation_taxes {
  id                       String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                String                 @db.Uuid
  trade_simulation_id      String                 @db.Uuid
  trade_simulation_item_id String?                @db.Uuid
  tax_type                 TradeSimulationTaxType
  base_amount_brl          Decimal?               @db.Decimal(19, 4)
  rate                     Decimal?               @db.Decimal(9, 6)
  amount_brl               Decimal                @db.Decimal(19, 4)
  metadata_json            Json?
  created_at               DateTime               @default(now()) @db.Timestamp(6)
  updated_at               DateTime               @default(now()) @db.Timestamp(6)

  trade_simulation      trade_simulations       @relation(fields: [trade_simulation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_trade_simulation_taxes_simulation")
  trade_simulation_item trade_simulation_items? @relation(fields: [trade_simulation_item_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_trade_simulation_taxes_item")

  @@index([tenant_id], map: "IDX_trade_simulation_taxes_tenant_id")
  @@index([tenant_id, trade_simulation_id], map: "IDX_trade_simulation_taxes_tenant_simulation")
}

model tax_profiles {
  id                              String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id                       String              @db.Uuid
  name                            String              @db.VarChar(120)
  type                            TradeSimulationType
  destination_state               String?             @db.VarChar(2)
  icms_rate                       Decimal?            @db.Decimal(9, 6)
  include_ipi_in_icms_base        Boolean             @default(true)
  include_pis_cofins_in_icms_base Boolean             @default(true)
  default_costs_json              Json?
  is_active                       Boolean             @default(true)
  created_at                      DateTime            @default(now()) @db.Timestamp(6)
  updated_at                      DateTime            @default(now()) @db.Timestamp(6)

  @@index([tenant_id], map: "IDX_tax_profiles_tenant_id")
  @@index([tenant_id, type], map: "IDX_tax_profiles_tenant_type")
}

model ncm_tax_rules {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id   String           @db.Uuid
  ncm         String           @db.VarChar(20)
  ii_rate     Decimal?         @db.Decimal(9, 6)
  ipi_rate    Decimal?         @db.Decimal(9, 6)
  pis_rate    Decimal?         @db.Decimal(9, 6)
  cofins_rate Decimal?         @db.Decimal(9, 6)
  valid_from  DateTime?        @db.Timestamp(6)
  valid_to    DateTime?        @db.Timestamp(6)
  source      NcmTaxRuleSource @default(MANUAL)
  notes       String?          @db.VarChar(500)
  created_at  DateTime         @default(now()) @db.Timestamp(6)
  updated_at  DateTime         @default(now()) @db.Timestamp(6)

  @@index([tenant_id], map: "IDX_ncm_tax_rules_tenant_id")
  @@index([tenant_id, ncm], map: "IDX_ncm_tax_rules_tenant_ncm")
}

model documents {
