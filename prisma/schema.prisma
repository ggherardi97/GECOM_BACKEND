  completed_at        DateTime?        @db.Timestamp(6)
  estimated_minutes   Int?
  actual_minutes      Int?
  created_by_user_id  String           @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamp(6)
  updated_at          DateTime         @default(now()) @db.Timestamp(6)

  incident         incidents           @relation(fields: [incident_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_service_tasks_incident")
  task_type        service_task_types? @relation(fields: [task_type_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_service_tasks_task_type")
  assigned_to_user users?              @relation("ServiceTaskAssignedTo", fields: [assigned_to_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_service_tasks_assigned_to")
  created_by_user  users               @relation("ServiceTaskCreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_service_tasks_created_by")

  @@index([tenant_id], map: "IDX_service_tasks_tenant_id")
  @@index([tenant_id, incident_id], map: "IDX_service_tasks_tenant_incident")
  @@index([tenant_id, status], map: "IDX_service_tasks_tenant_status")
}

