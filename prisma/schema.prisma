  to_stage        lead_pipeline_stages  @relation("LeadStageHistoryTo", fields: [to_stage_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_lead_stage_history_to_stage")
  changed_by_user users                 @relation("LeadStageChangedBy", fields: [changed_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_lead_stage_history_user")

  @@index([tenant_id, lead_id, changed_at(sort: Desc)], map: "IDX_lead_stage_history_tenant_lead_changed")
