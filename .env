# Ambiente
NODE_ENV=development
FRONTEND_URL="http://localhost:8080"

# API
API_CONTAINER_NAME=gecom-api
API_PORT=3000
DOCKERFILE=Dockerfile.dev

# Postgres
POSTGRES_VERSION=17
POSTGRES_CONTAINER_NAME=postgres-db
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=gecom_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gecom_db
# pgAdmin
PGADMIN_VERSION=latest
PGADMIN_CONTAINER_NAME=pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# mailer
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="No Reply <no-reply@gecom.com>"
MAIL_PREVIEW=false

JWT_SECRET=952faa58d5388bbf843d4434b6a2f829600835936ed7e9440814ad27188050696019ea15d3fbd6921ec8e23444b53352d8a50c99a5923dc341735815767eea49
